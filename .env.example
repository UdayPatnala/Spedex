# SpeDex Polyglot Repository — Root Environment Configuration Template
# Copy to appropriate .env files for local development.
# NEVER commit files containing actual secrets to Git!

# ── Backend (Spring Boot / Java) ──
# PORT: Local or container port (default: 8080)
PORT=8080
# JWT_SECRET: Minimum 256-bit cryptographic signing secret for tokens
JWT_SECRET=replace_with_a_secure_256_bit_cryptographic_secret_key_in_production
# Database (PostgreSQL for production; H2 file used by default in dev)
DATABASE_URL=jdbc:postgresql://localhost:5432/spedex
DB_USER=postgres
DB_PASSWORD=replace_with_secure_database_password

# ── Dashboard (React / Vite) ──
VITE_API_BASE_URL=http://localhost:8080/api
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=spedex-db.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spedex-db
VITE_FIREBASE_STORAGE_BUCKET=spedex-db.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ── Mobile (React Native / Expo) ──
EXPO_PUBLIC_API_URL=http://localhost:8080/api
